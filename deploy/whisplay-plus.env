# whisplay-plus hardware defaults. Override these on-device in
# /etc/default/whisplay-plus-gpio if your carrier board uses different pins.

# BCM GPIO number for the physical push-to-talk button.
WHISPLAY_BUTTON_GPIO=17

# whisplay-plus button is pressed = high, so use a pull-down by default.
WHISPLAY_BUTTON_PULL_UP=0

# BCM GPIO number(s) for the status LED. whisplay-plus exposes an RGB LED on
# BOARD 22/18/16, which are BCM GPIO25/24/23.
WHISPLAY_LED_GPIOS=25,24,23

# Browser key injected while the hardware button is held.
# The frontend's landscape mode maps "z" to push-to-talk for the active lane.
WHISPLAY_BUTTON_KEY=z

# Start the GPIO bridge from start.sh. Generic Pi deployments leave this unset.
WHISPLAY_ENABLE_GPIO=1

# Shared state file read by backend/server.py and frontend /api/hardware polling.
WHISPLAY_GPIO_STATE_FILE=/tmp/whisplay-plus-gpio-state.json

# X11 display used by Raspberry Pi OS/LXDE kiosk mode.
DISPLAY=:0

# Optional ALSA card substring used by deploy-whisplay-plus.sh when selecting
# the whisplay-sound card. Matching is case-insensitive.
WHISPLAY_SOUND_CARD_NAME=whisplay
